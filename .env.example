# Google Service Account Credentials for Google Drive API
# Obtain these from your Google Cloud Console (IAM & Admin -> Service Accounts)
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"

# The private key string from the service account JSON key file.
# Note: In environment variables, preserve the line breaks or escaped \n characters.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Supabase Credentials
# Obtain these from your Supabase Dashboard (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Production App URL (Optional - overrides preview branch deployment URLs when copying gallery link)
NEXT_PUBLIC_SITE_URL="https://kala-archives.vercel.app"

# Maintenance Mode Configuration
# Set to "true" to lock all routes and show maintenance page. Set to "false" (or omit) for normal operation.
MAINTENANCE_MODE="false"

# Optional bypass secret (Access yoursite.com?bypass=your-secret to view the app during maintenance)
MAINTENANCE_SECRET="admin-bypass-key-here"

# Optional custom maintenance message (leave empty to use default message)
NEXT_PUBLIC_MAINTENANCE_MESSAGE="We’re currently performing some maintenance to make things even better. We’ll be back online shortly."
